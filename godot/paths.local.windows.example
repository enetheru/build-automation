# Per-machine Tracy paths for Samuel's Windows machine.
# Copy to godot/paths.local.py (gitignored) and adjust; godot/config.py loads it
# when present. Any name left out keeps its default from config.py.
# The test harness (fibers.gd, toggle.gd, late_gpu/, trace_analyzer.cpp) comes
# from the Godot source under test.

TRACY_SOURCE_PATH = "C:/Godot/src/godot-private"
TRACY_REF = 'enetheru/4.7-tracy'
# Tracy v0.14.1 sources: the client for profiler_path and the server for the analyser.
TRACY_PROFILER_PATH = "C:/git/wolfpld/tracy"
TRACY_TOOLS_PATH = "C:/Users/nicho/AppData/Local/Microsoft/WinGet/Packages/wolfpld.tracy_Microsoft.Winget.Source_8wekyb3d8bbwe"
TRACY_CAPTURE = f"{TRACY_TOOLS_PATH}/tracy-capture.exe"
TRACY_CSVEXPORT = f"{TRACY_TOOLS_PATH}/tracy-csvexport.exe"
# The analyser is built from the fork's misc/scripts/tracy/trace_analyzer with
# CMake (cmake on PATH, or set TRACY_CMAKE) into logs-test/<build-name>/tools/. If that does
# not work here, build it once by hand and point at it instead:
# TRACY_ANALYZER = "C:/build/godot/tools/trace_analyzer.exe"
