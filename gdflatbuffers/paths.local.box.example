# Per-machine gdflatbuffers paths for the Linux box.
# Copy to gdflatbuffers/paths.local.py (gitignored) and adjust; gdflatbuffers/config.py
# loads it when present. Any name left out keeps its default from config.py.

# Local checkout to fetch the main source from. Unset keeps the GitHub url
# in config.py. Ref stays main, which must be a branch in that repo. Fetch
# sees committed refs only. libtracy fetches this same path at ref tracy.
# GDFB_SOURCE_PATH = '/path/to/godot-flatbuffers'

# Install prefix of every gdflatbuffers build (cmake --install --prefix). A
# relative path is under that build's source worktree; the default 'install'
# is <source>/install. An absolute path is used as given. Files land in
# <prefix>/addons/enetheru.flatbuffers-extension/. The prefix may be a Godot
# project. Main and libtracy each install into this prefix, and the merge key
# drops `.tracy`, so a libtracy install replaces the main build's slot for
# that platform and target (the last install wins).
# GDFB_INSTALL_PREFIX = '/workspace/gdflatbuffers-install'

# Godot project the libtracy test and bench use in place. The runner worktree
# gitignores `project`, so the default <source>/project has no project.godot.
# Set this to the same folder as GDFB_INSTALL_PREFIX when the build under test
# is the one just installed.
# GDFB_TRACY_PROJECT = '/path/to/Enetheru.flatbuffers-project'
